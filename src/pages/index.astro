---
import BaseLayout from '../layouts/BaseLayout.astro';

import Icon from '../components/Icon.astro';
import PostPreview from '../components/PostPreview.astro';
import { getPublishedPosts } from '../utils';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout>
	<main class="wrapper stack gap-10">
		<header class="intro stack gap-2">
			<h1>Samuel Brown</h1>
			<p>
				Software developer based in Wokingham, UK. I write about backend development, side
				projects, and things I'm learning along the way.
			</p>
		</header>

		<section class="stack gap-4">
			<ul class="post-list stack gap-4">
				{
					posts.map((post) => (
						<li>
							<PostPreview post={post} />
						</li>
					))
				}
			</ul>
			<a class="all-posts" href="/blog/">
				All posts <Icon icon="arrow-right" size="1.2em" />
			</a>
		</section>
	</main>
</BaseLayout>

<style>
	main {
		max-width: 60rem;
		padding-block: 3rem;
	}

	.intro h1 {
		font-family: var(--font-brand);
		font-size: var(--text-3xl);
		font-weight: 600;
		color: var(--gray-0);
		background-image: linear-gradient(
			83.21deg,
			var(--gray-0) 0%,
			var(--accent-dark) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		width: fit-content;
	}

	.intro p {
		font-size: var(--text-md);
		color: var(--gray-300);
		max-width: 54ch;
	}

	.post-list {
		list-style: none;
		padding: 0;
	}

	.all-posts {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
		color: var(--accent-regular);
		text-decoration: none;
		font-weight: 500;
	}

	.all-posts:hover,
	.all-posts:focus {
		text-decoration: underline;
	}

	@media (min-width: 50em) {
		.intro h1 {
			font-size: var(--text-4xl);
		}

		.intro p {
			font-size: var(--text-lg);
		}
	}
</style>
