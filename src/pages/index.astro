---
import BaseLayout from '../layouts/BaseLayout.astro';

import Icon from '../components/Icon.astro';
import PostPreview from '../components/PostPreview.astro';
import OnThisPage from '../components/OnThisPage.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { series } from '../series';
import { getPublishedPosts, readingTime } from '../utils';

const posts = await getPublishedPosts();

// Each set lists its posts oldest first, because they follow on from each other.
const sets = series
	.map((s) => ({
		...s,
		posts: posts
			.filter((p) => p.data.series === s.id)
			.sort((a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf()),
	}))
	.filter((s) => s.posts.length > 0);

// Minutes of reading in a set, from the same word count the cards show.
const setMinutes = (list: typeof posts) =>
	list.reduce((sum, p) => sum + parseInt(readingTime(p.body ?? ''), 10), 0);

const grouped = new Set(sets.flatMap((s) => s.posts.map((p) => p.id)));
const others = posts.filter((p) => !grouped.has(p.id));

const onThisPage = [
	...sets.map((s) => ({ slug: s.id, text: s.title })),
	...(others.length > 0 ? [{ slug: 'other', text: 'Other posts' }] : []),
];
---

<BaseLayout>
	<ReadingProgress />
	<main class="wrapper post-main">
	<div class="stack gap-15 post-body">
		<header class="intro stack gap-2">
			<h1>Samuel Brown</h1>
			<p>
				Software developer in Wokingham, UK. I build small models of things I'm curious about,
				sheepdogs and crop diseases so far, and write up what they taught me.
			</p>
			<a class="all-posts" href="/blog/">
				All posts <Icon icon="arrow-right" size="1.2em" />
			</a>
		</header>


		{
			sets.map((set) => (
				<section id={set.id} class="set stack gap-4">
					<header class="set-intro stack gap-2">
						<h2>{set.title}</h2>
						<span class="set-meta">
							{set.posts.length} {set.posts.length === 1 ? 'post' : 'posts'} · {setMinutes(set.posts)} min
						</span>
						<p>{set.blurb}</p>
					</header>
					<ol class="post-list stack gap-4">
						{set.posts.map((post, i) => (
							<li>
								<PostPreview
									post={post}
									step={set.posts.length > 1 ? i + 1 : undefined}
									hideTags
								/>
							</li>
						))}
					</ol>
				</section>
			))
		}

		{
			others.length > 0 && (
				<section id="other" class="set stack gap-4">
					<header class="set-intro stack gap-2">
						<h2>Other posts</h2>
					</header>
					<ul class="post-list stack gap-4">
						{others.map((post) => (
							<li>
								<PostPreview post={post} hideTags />
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
	<OnThisPage items={onThisPage} />
	</main>
</BaseLayout>

<style>
	main {
		max-width: 60rem;
		padding-block: 3rem;
	}

	.post-body {
		min-width: 0;
	}

	.intro h1 {
		font-family: var(--font-brand);
		font-size: var(--text-3xl);
		font-weight: 600;
		color: var(--gray-0);
		background-image: linear-gradient(
			83.21deg,
			var(--gray-0) 0%,
			var(--accent-dark) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		width: fit-content;
	}

	.intro p {
		font-size: var(--text-md);
		color: var(--gray-300);
		max-width: 54ch;
	}

	.set {
		scroll-margin-top: 2rem;
	}

	.set-intro h2 {
		font-family: var(--font-brand);
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--gray-0);
	}

	.set-meta {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.set-intro p {
		font-size: var(--text-base);
		line-height: 1.6;
		color: var(--gray-300);
		max-width: 68ch;
	}

	.post-list {
		list-style: none;
		padding: 0;
	}

	.all-posts {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
		margin-top: 0.5rem;
		color: var(--accent-dark);
		text-decoration: none;
		font-weight: 500;
	}

	.all-posts:hover,
	.all-posts:focus {
		text-decoration: underline;
	}

	@media (min-width: 50em) {
		.intro h1 {
			font-size: var(--text-4xl);
		}

		.intro p {
			font-size: var(--text-lg);
		}

		.set-intro h2 {
			font-size: var(--text-2xl);
		}

	.set-intro p {
			font-size: var(--text-md);
		}
	}
</style>
