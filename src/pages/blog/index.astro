---
import Search from 'astro-pagefind/components/Search.astro';

import BaseLayout from '../../layouts/BaseLayout.astro';

import Icon from '../../components/Icon.astro';
import PostPreview from '../../components/PostPreview.astro';
import { getPublishedPosts } from '../../utils';

const posts = await getPublishedPosts();
---

<BaseLayout title="All Posts | Samuel Brown" description="Articles and notes by Samuel Brown">
	<main class="wrapper stack gap-10">
		<header class="stack gap-2">
			<a class="back-link" href="/"><Icon icon="arrow-left" size="1.2em" /> Home</a>
			<h1>All posts</h1>
		</header>

		<Search id="search" className="pagefind-ui" uiOptions={{ showImages: false }} />

		<ul class="post-list stack gap-4">
			{
				posts.map((post) => (
					<li>
						<PostPreview post={post} />
					</li>
				))
			}
		</ul>
	</main>
</BaseLayout>

<style>
	main {
		max-width: 60rem;
		padding-block: 3rem;
	}

	h1 {
		font-family: var(--font-brand);
		font-size: var(--text-3xl);
		font-weight: 600;
		color: var(--gray-0);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
		color: var(--accent-regular);
		text-decoration: none;
		font-weight: 500;
	}

	.back-link:hover,
	.back-link:focus {
		text-decoration: underline;
	}

	.post-list {
		list-style: none;
		padding: 0;
	}

	@media (min-width: 50em) {
		h1 {
			font-size: var(--text-4xl);
		}
	}
</style>

<style is:global>
	pagefind-searchbox.pagefind-ui {
		display: block;
		max-width: 60rem;
		--pf-font: var(--font-body);
		--pf-background: var(--gray-999);
		--pf-text: var(--gray-0);
		--pf-text-secondary: var(--gray-300);
		--pf-text-muted: var(--gray-400);
		--pf-border: var(--gray-800);
		--pf-border-focus: var(--accent-dark);
		--pf-outline-focus: var(--accent-dark);
		--pf-hover: var(--gray-900);
		--pf-skeleton: var(--gray-900);
		--pf-skeleton-shine: var(--gray-800);
		--pf-mark: var(--gray-0);
		--pf-scroll-shadow: rgba(255, 255, 255, 0.08);
		--pf-shadow-sm: var(--shadow-sm);
		--pf-shadow-md: var(--shadow-md);
		--pf-shadow-lg: var(--shadow-md);
		--pf-border-radius: 0.75rem;
		--pf-input-height: 3rem;
		--pf-input-font-size: var(--text-md);
		--pf-result-title-font-size: var(--text-md);
		--pf-result-excerpt-font-size: var(--text-sm);
		--pf-searchbox-max-width: 60rem;
		--pf-icon-search: url("data:image/svg+xml,%3Csvg width='18' height='18' viewBox='0 0 18 18' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12.7549 11.255H11.9649L11.6849 10.985C12.6649 9.845 13.2549 8.365 13.2549 6.755C13.2549 3.165 10.3449 0.255005 6.75488 0.255005C3.16488 0.255005 0.254883 3.165 0.254883 6.755C0.254883 10.345 3.16488 13.255 6.75488 13.255C8.36488 13.255 9.84488 12.665 10.9849 11.685L11.2549 11.965V12.755L16.2549 17.745L17.7449 16.255L12.7549 11.255ZM6.75488 11.255C4.26488 11.255 2.25488 9.245 2.25488 6.755C2.25488 4.26501 4.26488 2.255 6.75488 2.255C9.24488 2.255 11.2549 4.26501 11.2549 6.755C11.2549 9.245 9.24488 11.255 6.75488 11.255Z' fill='%23a3acc8'/%3E%3C/svg%3E%0A");
	}

	pagefind-searchbox.pagefind-ui mark {
		background: var(--accent-overlay);
		color: var(--gray-0);
		border-radius: 0.25em;
	}
</style>
