---
import type { CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import Comments from '../../components/Comments.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import { formatDate, getPublishedPosts, readingTime, slugifyTag } from '../../utils';

interface Props {
	entry: CollectionEntry<'blog'>;
	newer: CollectionEntry<'blog'> | null;
	older: CollectionEntry<'blog'> | null;
}

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((entry, i) => ({
		params: { slug: entry.slug },
		props: { entry, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
	}));
}

const { entry, newer, older } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	image={`/og/${entry.slug}.png`}
>
	<div class="progress" aria-hidden="true"></div>
	<main class="wrapper stack gap-8">
		<header class="stack gap-4">
			<a class="back-link" href="/blog/"><Icon icon="arrow-left" size="1.2em" /> All posts</a>
			<h1>{entry.data.title}</h1>
			<div class="meta">
				<span class="date-line">
					<time datetime={entry.data.publishDate.toISOString()}>
						{formatDate(entry.data.publishDate)}
					</time>
					&middot; {readingTime(entry.body)}
				</span>
				{
					entry.data.tags.length > 0 && (
						<div class="tags">
							{entry.data.tags.map((t) => (
								<a class="tag-link" href={`/blog/tags/${slugifyTag(t)}/`}>
									<Pill>{t}</Pill>
								</a>
							))}
						</div>
					)
				}
			</div>
		</header>

		<article class="stack gap-8" data-pagefind-body>
			{entry.data.img && <img class="cover" src={entry.data.img} alt={entry.data.img_alt || ''} />}
			<div class="content">
				<Content />
			</div>
		</article>

		<nav class="post-nav" aria-label="Adjacent posts" data-pagefind-ignore>
			{
				newer ? (
					<a class="adjacent" href={`/blog/${newer.slug}/`}>
						<span class="dir">← Newer</span>
						<span class="name">{newer.data.title}</span>
					</a>
				) : (
					<span />
				)
			}
			{
				older && (
					<a class="adjacent align-end" href={`/blog/${older.slug}/`}>
						<span class="dir">Older →</span>
						<span class="name">{older.data.title}</span>
					</a>
				)
			}
		</nav>

		<Comments />
	</main>
</BaseLayout>

<script>
	function trackProgress() {
		const bar = document.querySelector<HTMLElement>('.progress');
		if (!bar) return;
		const update = () => {
			const max = document.documentElement.scrollHeight - window.innerHeight;
			bar.style.width = max > 0 ? `${(window.scrollY / max) * 100}%` : '0%';
		};
		update();
		addEventListener('scroll', update, { passive: true });
	}
	document.addEventListener('astro:page-load', trackProgress);
</script>

<style>
	main {
		max-width: 60rem;
		padding-block: 3rem;
	}

	header {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--gray-800);
	}

	h1 {
		font-family: var(--font-brand);
		font-size: var(--text-3xl);
		font-weight: 600;
		color: var(--gray-0);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
		color: var(--accent-regular);
		text-decoration: none;
		font-weight: 500;
	}

	.back-link:hover,
	.back-link:focus {
		text-decoration: underline;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}

	.date-line {
		font-family: var(--font-mono);
		color: var(--gray-300);
		font-size: var(--text-sm);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag-link {
		text-decoration: none;
	}

	.cover {
		width: 100%;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid var(--gray-800);
	}

	.progress {
		position: fixed;
		top: 0;
		left: 0;
		height: 3px;
		width: 0;
		background: linear-gradient(90deg, var(--accent-regular), var(--accent-dark));
		z-index: 100;
	}

	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		border-top: 1px solid var(--gray-800);
		padding-top: 2rem;
	}

	.adjacent {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		text-decoration: none;
	}

	.adjacent .dir {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--gray-300);
	}

	.adjacent .name {
		color: var(--gray-100);
		font-weight: 500;
	}

	.adjacent:hover .name,
	.adjacent:focus .name {
		text-decoration: underline;
	}

	.align-end {
		align-items: flex-end;
		text-align: right;
	}

	.content :global(.anchor-link) {
		opacity: 0;
		color: var(--accent-dark);
		text-decoration: none;
		transition: opacity 0.15s ease-in-out;
	}

	.content :global(h1:hover .anchor-link),
	.content :global(h2:hover .anchor-link),
	.content :global(h3:hover .anchor-link),
	.content :global(h4:hover .anchor-link),
	.content :global(h5:hover .anchor-link),
	.content :global(.anchor-link:focus) {
		opacity: 1;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4),
	.content :global(h5) {
		margin: 1.5rem 0;
	}

	.content :global(img) {
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
	}

	.content :global(blockquote) {
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 600;
		line-height: 1.1;
		padding-inline-start: 1.5rem;
		border-inline-start: 0.25rem solid var(--accent-dark);
		color: var(--gray-0);
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		h1 {
			font-size: var(--text-4xl);
		}

		.content :global(blockquote) {
			font-size: var(--text-2xl);
		}
	}
</style>
