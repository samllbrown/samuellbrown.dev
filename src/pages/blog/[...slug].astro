---
import { render, type CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import Comments from '../../components/Comments.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import { formatDate, getPublishedPosts, readingTime, slugifyTag } from '../../utils';

interface Props {
	entry: CollectionEntry<'blog'>;
	newer: CollectionEntry<'blog'> | null;
	older: CollectionEntry<'blog'> | null;
}

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((entry, i) => ({
		params: { slug: entry.id },
		props: { entry, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
	}));
}

const { entry, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	image={`/og/${entry.id}.png`}
>
	<div class="progress" aria-hidden="true"></div>
	<main class="wrapper post-main">
	<div class="stack gap-8 post-body">
		<header class="stack gap-4">
			<a class="back-link" href="/blog/"><Icon icon="arrow-left" size="1.2em" /> All posts</a>
			<h1>{entry.data.title}</h1>
			<div class="meta">
				<span class="date-line">
					<time datetime={entry.data.publishDate.toISOString()}>
						{formatDate(entry.data.publishDate)}
					</time>
					&middot; {readingTime(entry.body)}
				</span>
				{
					entry.data.tags.length > 0 && (
						<div class="tags">
							{entry.data.tags.map((t) => (
								<a class="tag-link" href={`/blog/tags/${slugifyTag(t)}/`}>
									<Pill>{t}</Pill>
								</a>
							))}
						</div>
					)
				}
			</div>
		</header>

		<article class="stack gap-8" data-pagefind-body>
			{entry.data.img && <img class="cover" src={entry.data.img} alt={entry.data.img_alt || ''} />}
			<div class="content">
				<Content />
			</div>
		</article>

		<nav class="post-nav" aria-label="Adjacent posts" data-pagefind-ignore>
			{
				newer ? (
					<a class="adjacent" href={`/blog/${newer.id}/`}>
						<span class="dir">← Newer</span>
						<span class="name">{newer.data.title}</span>
					</a>
				) : (
					<span />
				)
			}
			{
				older && (
					<a class="adjacent align-end" href={`/blog/${older.id}/`}>
						<span class="dir">Older →</span>
						<span class="name">{older.data.title}</span>
					</a>
				)
			}
		</nav>

		<Comments />
	</div>
	{
		toc.length > 2 && (
			<aside class="toc" aria-label="On this page" data-pagefind-ignore>
				<p class="toc-label">On this page</p>
				<nav class="toc-nav">
					<div class="toc-marker" aria-hidden="true"></div>
					<ul>
						{toc.map((h) => (
							<li class={h.depth === 3 ? 'depth-3' : ''}>
								<a href={`#${h.slug}`} data-slug={h.slug}>{h.text.replace(/\s*#\s*$/, '')}</a>
							</li>
						))}
					</ul>
				</nav>
			</aside>
		)
	}
	</main>
</BaseLayout>

<script>
	function trackProgress() {
		const bar = document.querySelector<HTMLElement>('.progress');
		if (!bar) return;
		const update = () => {
			const max = document.documentElement.scrollHeight - window.innerHeight;
			bar.style.width = max > 0 ? `${(window.scrollY / max) * 100}%` : '0%';
		};
		update();
		addEventListener('scroll', update, { passive: true });
	}
	document.addEventListener('astro:page-load', trackProgress);

	// "On this page": highlight the heading that's currently in view and slide the marker to it.
	function trackToc() {
		const toc = document.querySelector<HTMLElement>('.toc');
		if (!toc) return;
		const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[data-slug]'));
		const marker = toc.querySelector<HTMLElement>('.toc-marker');
		const heads = links.map((a) => document.getElementById(a.dataset.slug || '')).filter(Boolean) as HTMLElement[];
		if (!heads.length) return;
		let current = '';
		const update = () => {
			const line = window.innerHeight * 0.3;
			let active = heads[0];
			for (const h of heads) if (h.getBoundingClientRect().top <= line) active = h;
			if (active.id === current) return;
			current = active.id;
			links.forEach((a) => a.classList.toggle('active', a.dataset.slug === current));
			const a = links.find((l) => l.dataset.slug === current);
			if (a && marker) {
				const nav = toc.querySelector<HTMLElement>('.toc-nav')!;
				// .toc-nav is positioned, so a.offsetTop is already relative to it, and an
				// absolutely positioned marker scrolls with the nav's content.
				const top = a.offsetTop;
				marker.style.top = `${top}px`;
				marker.style.height = `${a.offsetHeight}px`;
				marker.style.opacity = '1';
				if (top < nav.scrollTop || top > nav.scrollTop + nav.clientHeight - a.offsetHeight) nav.scrollTo({ top: top - nav.clientHeight / 2, behavior: 'smooth' });
			}
		};
		update();
		addEventListener('scroll', update, { passive: true });
		addEventListener('resize', update);
	}
	document.addEventListener('astro:page-load', trackToc);
</script>

<style>
	main {
		max-width: 60rem;
		padding-block: 3rem;
	}

	.post-body {
		min-width: 0;
	}

	/* "On this page", beside the post on wide screens, hidden otherwise. */
	.toc {
		display: none;
	}

	/* Medium-wide screens: the article gives up a little room on the right for the sidebar. */
	@media (min-width: 78em) {
		main.post-main {
			max-width: 72rem;
			display: grid;
			grid-template-columns: minmax(0, 60rem) 11rem;
			gap: 1rem;
			align-items: start;
		}

		.toc {
			/* fixed rather than sticky: an overflow rule further up the page defeats sticky */
			display: block;
			position: fixed;
			top: 50%;
			transform: translateY(-50%);
			left: calc(50% + 25rem);
			width: 11rem;
			font-size: var(--text-sm);
			line-height: 1.45;
		}
	}

	/* Wide screens: the article sits exactly where it does on every other post, sidebar in the margin. */
	@media (min-width: 88em) {
		main.post-main {
			max-width: 60rem;
			display: block;
		}

		.toc {
			left: calc(50% + 31.5rem);
		}
	}

	.toc-label {
		margin: 0 0 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--gray-300);
	}

	.toc-nav {
		/* The border lives on the list, not here: this is a scroll container, and a
		   scroll container clips absolute children to its padding box, so a marker
		   sitting over a border on this element would never show. */
		position: relative;
		max-height: calc(100dvh - 8rem);
		overflow-y: auto;
		scrollbar-width: none;
		mask-image: linear-gradient(to bottom, transparent, #000 1rem, #000 calc(100% - 1rem), transparent);
	}

	.toc-nav::-webkit-scrollbar {
		display: none;
	}

	.toc-marker {
		position: absolute;
		left: 0;
		top: 0;
		width: 2px;
		height: 0;
		background: var(--accent-dark);
		border-radius: 2px;
		opacity: 0;
		transition: top 0.2s ease, height 0.2s ease, opacity 0.2s ease;
	}

	.toc ul {
		list-style: none;
		margin: 0;
		padding: 0.5rem 0;
		border-left: 2px solid var(--gray-800);
	}

	.toc li {
		margin: 0;
	}

	.toc li.depth-3 a {
		padding-left: 1.8rem;
	}

	.toc a {
		display: block;
		padding: 0.22rem 0 0.22rem 0.9rem;
		color: var(--gray-300);
		text-decoration: none;
	}

	.toc a:hover {
		color: var(--gray-100);
	}

	.toc a.active {
		color: var(--gray-0);
		font-weight: 500;
	}

	header {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--gray-800);
	}

	h1 {
		font-family: var(--font-brand);
		font-size: var(--text-3xl);
		font-weight: 600;
		color: var(--gray-0);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
		color: var(--accent-regular);
		text-decoration: none;
		font-weight: 500;
	}

	.back-link:hover,
	.back-link:focus {
		text-decoration: underline;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}

	.date-line {
		font-family: var(--font-mono);
		color: var(--gray-300);
		font-size: var(--text-sm);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag-link {
		text-decoration: none;
	}

	.cover {
		width: 100%;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid var(--gray-800);
	}

	.progress {
		position: fixed;
		top: 0;
		left: 0;
		height: 3px;
		width: 0;
		background: linear-gradient(90deg, var(--accent-regular), var(--accent-dark));
		z-index: 100;
	}

	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		border-top: 1px solid var(--gray-800);
		padding-top: 2rem;
	}

	.adjacent {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		text-decoration: none;
	}

	.adjacent .dir {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--gray-300);
	}

	.adjacent .name {
		color: var(--gray-100);
		font-weight: 500;
	}

	.adjacent:hover .name,
	.adjacent:focus .name {
		text-decoration: underline;
	}

	.align-end {
		align-items: flex-end;
		text-align: right;
	}

	.content :global(.anchor-link) {
		opacity: 0;
		color: var(--accent-dark);
		text-decoration: none;
		transition: opacity 0.15s ease-in-out;
	}

	.content :global(h1:hover .anchor-link),
	.content :global(h2:hover .anchor-link),
	.content :global(h3:hover .anchor-link),
	.content :global(h4:hover .anchor-link),
	.content :global(h5:hover .anchor-link),
	.content :global(.anchor-link:focus) {
		opacity: 1;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4),
	.content :global(h5) {
		margin: 1.5rem 0;
	}

	.content :global(img) {
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
	}

	.content :global(blockquote) {
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 600;
		line-height: 1.1;
		padding-inline-start: 1.5rem;
		border-inline-start: 0.25rem solid var(--accent-dark);
		color: var(--gray-0);
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		h1 {
			font-size: var(--text-4xl);
		}

		.content :global(blockquote) {
			font-size: var(--text-2xl);
		}
	}
</style>
