---
import BaseLayout from '../../../layouts/BaseLayout.astro';

import Icon from '../../../components/Icon.astro';
import PostPreview from '../../../components/PostPreview.astro';
import { getPublishedPosts, slugifyTag } from '../../../utils';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const tags = new Map<string, { label: string; posts: typeof posts }>();
	for (const post of posts) {
		for (const tag of post.data.tags) {
			const slug = slugifyTag(tag);
			if (!tags.has(slug)) tags.set(slug, { label: tag, posts: [] });
			tags.get(slug)!.posts.push(post);
		}
	}
	return [...tags.entries()].map(([tag, { label, posts }]) => ({
		params: { tag },
		props: { label, posts },
	}));
}

const { label, posts } = Astro.props;
---

<BaseLayout
	title={`${label} | Blog | Samuel Brown`}
	description={`Blog posts tagged “${label}”`}
>
	<main class="wrapper stack gap-10">
		<header class="stack gap-2">
			<a class="back-link" href="/blog/"><Icon icon="arrow-left" size="1.2em" /> All posts</a>
			<h1>Tagged “{label}”</h1>
		</header>

		<ul class="post-list stack gap-4">
			{
				posts.map((post) => (
					<li>
						<PostPreview post={post} />
					</li>
				))
			}
		</ul>
	</main>
</BaseLayout>

<style>
	main {
		max-width: 60rem;
		padding-block: 3rem;
	}

	h1 {
		font-family: var(--font-brand);
		font-size: var(--text-3xl);
		font-weight: 600;
		color: var(--gray-0);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
		color: var(--accent-regular);
		text-decoration: none;
		font-weight: 500;
	}

	.back-link:hover,
	.back-link:focus {
		text-decoration: underline;
	}

	.post-list {
		list-style: none;
		padding: 0;
	}

	@media (min-width: 50em) {
		h1 {
			font-size: var(--text-4xl);
		}
	}
</style>
