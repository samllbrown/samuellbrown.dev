{
  "hosting": {
    "public": "./dist",
    "redirects": [
      {
        "source": "/work",
        "destination": "/blog/",
        "type": 301
      },
      {
        "source": "/work/:slug*",
        "destination": "/blog/:slug*",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
